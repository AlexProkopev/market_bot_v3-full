BOT_TOKEN=
ADMIN_ID=

# Preferred Railway setup: attach a PostgreSQL service and Railway will provide DATABASE_URL
DATABASE_URL=

# Optional fallback if your template exposes split PostgreSQL variables instead of DATABASE_URL
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# Optional integrations
OPENAI_API_KEY=
YANDEX_API_KEY=
DGIS_API_KEY=
LTC_WALLET_ADDRESS=

# Optional debug flags
GEO_DEBUG=0
GEO_ENABLE_GPT_DISTRICTS_FALLBACK=0
GEO_ENABLE_GPT_LANDMARKS_FALLBACK=1
GEO_CONTACT_EMAIL=geo_check@internal.service